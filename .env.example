# OpenVerse Hide & Seek — Environment Configuration

# Supabase Configuration
# Leave as placeholder or empty to use MOCK MODE (full local state + BroadcastChannel realtime)
# To use Supabase: provide your project credentials from Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional GitHub Challenge Repository (for external seeker challenges)
# If configured, public challenge questions are fetched dynamically from GitHub.
# Answers are NEVER exposed to the frontend.
VITE_GITHUB_OWNER=your-org
VITE_GITHUB_REPO=hidenseek-challenges
VITE_GITHUB_BRANCH=main
